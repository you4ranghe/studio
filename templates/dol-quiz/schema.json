{
  "version": 2,
  "_": "이 파일이 편집기 폼을 만듭니다. 폼 코드는 템플릿마다 새로 짜지 않습니다.",
  "__sections": "각 구획은 결과물의 장면 하나와 짝입니다(slide). 그래서 왼쪽 목차가 곧 결과물 목차입니다.",

  "sections": [
    {
      "id": "cover",
      "label": "표지",
      "slide": "title",
      "group": "인트로",
      "desc": "맨 앞 장과 화면 위쪽 상태바입니다.",
      "fields": [
        {
          "path": "hud.name",
          "type": "text",
          "label": "아이 이름",
          "placeholder": "하윤",
          "maxLength": 6,
          "required": true,
          "hint": "화면 왼쪽 위 상태바에 표시됩니다. 두세 글자가 가장 예쁩니다."
        },
        {
          "path": "cover.eyebrow",
          "type": "text",
          "label": "표지 윗줄",
          "placeholder": "퀴즈 게임을 시작합니다",
          "maxLength": 24
        },
        {
          "path": "cover.titleEn.0",
          "type": "text",
          "label": "표지 큰 글씨 1줄",
          "placeholder": "QUIZ",
          "maxLength": 8,
          "hint": "영문 픽셀 글씨입니다. 한글은 이 글씨체가 없어 깨집니다."
        },
        {
          "path": "cover.titleEn.1",
          "type": "text",
          "label": "표지 큰 글씨 2줄",
          "placeholder": "GAME",
          "maxLength": 8
        },
        {
          "path": "cover.image",
          "type": "image",
          "label": "표지 사진",
          "optional": true,
          "hint": "표지 큰 글씨 위에 들어갑니다. 얼굴이 가운데 오는 사진이 예쁩니다."
        },
        {
          "path": "hud.lives",
          "type": "select",
          "label": "상태바 하트 개수",
          "default": 3,
          "choices": [
            { "value": 3, "label": "3개" },
            { "value": 2, "label": "2개" },
            { "value": 1, "label": "1개" }
          ]
        }
      ]
    },

    {
      "id": "greeting",
      "label": "인사말",
      "slide": "message",
      "group": "인트로",
      "desc": "하객에게 건네는 첫 인사입니다. 비우면 이 장은 만들어지지 않습니다.",
      "fields": [
        { "path": "greeting.title", "type": "text", "label": "제목", "maxLength": 8 },
        {
          "path": "greeting.lines",
          "type": "repeater",
          "label": "인사말",
          "of": "text",
          "min": 0, "max": 6,
          "addLabel": "줄 추가",
          "maxLength": 34,
          "markup": true
        }
      ]
    },

    {
      "id": "rules",
      "label": "게임 규칙",
      "slide": "rules",
      "group": "인트로",
      "desc": "진행 방식을 하객에게 알려주는 장입니다.",
      "fields": [
        { "path": "rules.title", "type": "text", "label": "제목", "maxLength": 8 },
        {
          "path": "rules.items",
          "type": "repeater",
          "label": "규칙",
          "of": "text",
          "min": 0, "max": 5,
          "addLabel": "규칙 추가",
          "maxLength": 30,
          "markup": true
        }
      ]
    },

    {
      "id": "start",
      "label": "게임 시작",
      "slide": "start",
      "group": "인트로",
      "desc": "퀴즈로 넘어가기 직전 장입니다.",
      "fields": [
        { "path": "start.title", "type": "text", "label": "제목", "maxLength": 8 },
        {
          "path": "start.lines",
          "type": "repeater",
          "label": "문구",
          "of": "text",
          "min": 0, "max": 4,
          "addLabel": "줄 추가",
          "maxLength": 34,
          "markup": true
        }
      ]
    },

    {
      "id": "quiz",
      "label": "문제",
      "slide": "quiz",
      "group": "문제",
      "desc": "5문제마다 배경이 지상에서 지하로 바뀝니다. 문제 수는 자유입니다.",
      "fields": [
        {
          "path": "quiz",
          "type": "repeater",
          "label": "문제",
          "itemLabel": "Q{n}",
          "min": 1, "max": 20, "recommended": 10,
          "addLabel": "문제 추가",
          "collapsible": true,
          "suggest": { "nameFrom": "hud.name", "blankLabel": "직접 쓰기" },
          "fields": [
            {
              "path": "question",
              "type": "longtext",
              "label": "문제",
              "rows": 3,
              "maxLength": 90,
              "required": true,
              "hint": "엔터로 줄을 나눌 수 있습니다. 글자 크기는 길이에 맞춰 자동으로 줄어듭니다."
            },
            {
              "path": "image",
              "type": "image",
              "label": "문제 사진",
              "optional": true,
              "hint": "문제 글 아래에 들어갑니다. \"이 사진은 언제 찍었을까요?\" 같은 문제에 씁니다."
            },
            {
              "path": "layout",
              "type": "select",
              "label": "보기 방식",
              "default": "text",
              "compact": true,
              "affectsForm": true,
              "choices": [
                { "value": "text",    "label": "글자",          "desc": "보기를 글자로 보여줍니다" },
                { "value": "photo",   "label": "사진",          "desc": "보기마다 사진을 붙입니다. 글자를 같이 쓰면 사진 아래에 나옵니다" },
                { "value": "numbers", "label": "번호만 (실물)", "desc": "실물·사진을 앞에 두고 번호로 고릅니다. 보기 화면이 한 장 더 생깁니다" }
              ]
            },
            {
              "path": "options",
              "type": "options",
              "label": "보기",
              "min": 2, "max": 5, "recommended": 5,
              "addLabel": "보기 추가",
              "maxLength": 14,
              "numbered": true,
              "image": { "when": "layout", "is": "photo" }
            },
            {
              "path": "answerIndex",
              "type": "answer",
              "label": "정답",
              "source": "options",
              "required": true,
              "hint": "고른 보기가 그대로 정답 화면에 나옵니다. 보기와 정답이 어긋날 수 없습니다."
            },
            {
              "path": "note",
              "type": "text",
              "label": "작은 주석",
              "maxLength": 34,
              "optional": true,
              "placeholder": "*앨범에서 얼굴 인식, 26.09.13 기준"
            },
            {
              "path": "nav",
              "type": "text",
              "label": "목차 이름",
              "maxLength": 9,
              "optional": true,
              "hint": "비워두면 문제 앞부분을 따서 씁니다."
            }
          ]
        }
      ]
    },

    {
      "id": "ending",
      "label": "마무리",
      "slide": "clear",
      "group": "엔딩",
      "desc": "골인 화면입니다.",
      "fields": [
        { "path": "ending.title", "type": "text", "label": "제목", "maxLength": 16, "hint": "영문 픽셀 글씨입니다." },
        {
          "path": "ending.lines",
          "type": "repeater",
          "label": "감사 인사",
          "of": "text",
          "min": 0, "max": 4,
          "addLabel": "줄 추가",
          "maxLength": 28,
          "markup": true
        },
        {
          "path": "ending.image",
          "type": "image",
          "label": "마무리 사진",
          "optional": true,
          "hint": "감사 인사 아래에 들어갑니다. 가족사진이 잘 어울립니다."
        },
        {
          "path": "ending.showCoins",
          "type": "toggle",
          "label": "획득 코인 수 보여주기",
          "default": true
        }
      ]
    }
  ],

  "markupHelp": [
    { "syntax": "엔터",    "result": "줄바꿈" },
    { "syntax": "*글자*",   "result": "빨강" },
    { "syntax": "**글자**", "result": "금색" }
  ]
}
