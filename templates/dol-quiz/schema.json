{
  "version": 1,
  "_": "이 파일이 편집기 폼을 만듭니다. 폼 코드는 템플릿마다 새로 짜지 않습니다.",

  "steps": [
    {
      "id": "basic",
      "label": "기본 정보",
      "desc": "표지와 화면 위쪽 상태바에 들어갑니다.",
      "fields": [
        {
          "path": "hud.name",
          "type": "text",
          "label": "아이 이름",
          "placeholder": "하윤",
          "maxLength": 6,
          "required": true,
          "hint": "화면 왼쪽 위 상태바에 표시됩니다. 두세 글자가 가장 예쁩니다."
        },
        {
          "path": "cover.eyebrow",
          "type": "text",
          "label": "표지 윗줄",
          "placeholder": "퀴즈 게임을 시작합니다",
          "maxLength": 24
        },
        {
          "path": "cover.titleEn.0",
          "type": "text",
          "label": "표지 큰 글씨 1줄",
          "placeholder": "QUIZ",
          "maxLength": 8,
          "hint": "영문 픽셀 글씨입니다. 한글은 이 글씨체가 없어 깨집니다."
        },
        {
          "path": "cover.titleEn.1",
          "type": "text",
          "label": "표지 큰 글씨 2줄",
          "placeholder": "GAME",
          "maxLength": 8
        }
      ]
    },

    {
      "id": "intro",
      "label": "인사말 · 규칙",
      "desc": "퀴즈 시작 전에 보여줄 세 장입니다. 비워두면 그 장은 만들어지지 않습니다.",
      "fields": [
        { "path": "greeting.title", "type": "text", "label": "인사말 제목", "maxLength": 8 },
        {
          "path": "greeting.lines",
          "type": "repeater",
          "label": "인사말",
          "of": "text",
          "min": 0, "max": 6,
          "addLabel": "줄 추가",
          "maxLength": 34,
          "markup": true
        },
        { "path": "rules.title", "type": "text", "label": "규칙 제목", "maxLength": 8 },
        {
          "path": "rules.items",
          "type": "repeater",
          "label": "게임 규칙",
          "of": "text",
          "min": 0, "max": 5,
          "addLabel": "규칙 추가",
          "maxLength": 30,
          "markup": true
        },
        { "path": "start.title", "type": "text", "label": "시작 화면 제목", "maxLength": 8 },
        {
          "path": "start.lines",
          "type": "repeater",
          "label": "시작 화면 문구",
          "of": "text",
          "min": 0, "max": 4,
          "addLabel": "줄 추가",
          "maxLength": 34,
          "markup": true
        }
      ]
    },

    {
      "id": "quiz",
      "label": "퀴즈",
      "desc": "5문제마다 배경이 지상 → 지하로 바뀝니다. 문제 수는 자유입니다.",
      "fields": [
        {
          "path": "quiz",
          "type": "repeater",
          "label": "문제",
          "itemLabel": "Q{n}",
          "min": 1, "max": 20, "recommended": 10,
          "addLabel": "문제 추가",
          "preview": { "kind": "question" },
          "fields": [
            {
              "path": "question",
              "type": "longtext",
              "label": "문제",
              "rows": 3,
              "maxLength": 90,
              "required": true,
              "hint": "엔터로 줄을 나눌 수 있습니다. 글자 크기는 길이에 맞춰 자동으로 줄어듭니다."
            },
            {
              "path": "layout",
              "type": "select",
              "label": "보기 방식",
              "default": "text",
              "choices": [
                { "value": "text",    "label": "글자 보기",     "desc": "보기 5개를 문제와 같은 화면에 보여줍니다" },
                { "value": "numbers", "label": "번호만 (실물)", "desc": "실물·사진을 앞에 두고 번호로 고릅니다. 보기 화면이 한 장 더 생깁니다" }
              ]
            },
            {
              "path": "options",
              "type": "repeater",
              "label": "보기",
              "of": "text",
              "min": 2, "max": 5, "recommended": 5,
              "addLabel": "보기 추가",
              "maxLength": 14,
              "numbered": true
            },
            {
              "path": "answerIndex",
              "type": "answer",
              "label": "정답",
              "source": "options",
              "required": true,
              "hint": "고른 보기가 그대로 정답 화면에 나옵니다. 보기와 정답이 어긋날 수 없습니다."
            },
            {
              "path": "note",
              "type": "text",
              "label": "작은 주석",
              "maxLength": 34,
              "optional": true,
              "placeholder": "*앨범에서 얼굴 인식, 26.09.13 기준"
            },
            {
              "path": "nav",
              "type": "text",
              "label": "목차 이름",
              "maxLength": 9,
              "optional": true,
              "hint": "비워두면 문제 앞부분을 따서 씁니다."
            }
          ]
        }
      ]
    },

    {
      "id": "ending",
      "label": "마무리",
      "desc": "마지막 골인 화면입니다.",
      "fields": [
        { "path": "ending.title", "type": "text", "label": "제목", "maxLength": 16, "hint": "영문 픽셀 글씨입니다." },
        {
          "path": "ending.lines",
          "type": "repeater",
          "label": "감사 인사",
          "of": "text",
          "min": 0, "max": 4,
          "addLabel": "줄 추가",
          "maxLength": 28,
          "markup": true
        },
        {
          "path": "ending.showCoins",
          "type": "toggle",
          "label": "획득 코인 수 보여주기",
          "default": true
        },
        {
          "path": "hud.lives",
          "type": "select",
          "label": "상태바 하트 개수",
          "default": 3,
          "choices": [
            { "value": 1, "label": "1개" },
            { "value": 2, "label": "2개" },
            { "value": 3, "label": "3개" }
          ]
        }
      ]
    }
  ],

  "markupHelp": [
    { "syntax": "엔터",    "result": "줄바꿈" },
    { "syntax": "*글자*",   "result": "빨간 강조" },
    { "syntax": "**글자**", "result": "금색 강조" }
  ]
}
